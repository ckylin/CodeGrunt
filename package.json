{
  "name": "codegrunt",
  "version": "0.1.3",
  "description": "An AI-powered CLI coding assistant for the terminal — built on DeepSeek",
  "type": "module",
  "bin": {
    "codegrunt": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx scripts/bench.ts",
    "start": "node dist/cli/index.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint src tests",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "adm-zip": "^0.5.17",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "diff": "^9.0.0",
    "ink": "^5.2.1",
    "openai": "^4.52.0",
    "ora": "^8.0.1",
    "react": "^18.3.0",
    "string-width": "^8.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/adm-zip": "^0.5.8",
    "@types/diff": "^7.0.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "eslint": "9.39.5",
    "ink-testing-library": "^4.0.0",
    "prettier": "3.9.9",
    "tsx": "^4.22.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "8.71.1",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
